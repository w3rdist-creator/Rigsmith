{
  "name": "rigsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Rigsmith \u2014 an independent browser-based 2D skeletal animation editor (initial vertical slice).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47613 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47613 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:wiz": "node --test --test-concurrency=1 \"tests/acceptance/**/*.test.ts\"",
    "wiz:prepare": "python3 -I scripts/wiz/prepare_cutouts.py .hermes/assets/wiz/source/wiz_master.png .hermes/assets/wiz/prepared",
    "wiz:build": "node scripts/wiz/build-in-editor.ts && python3 -I scripts/wiz/compare_setup.py .hermes/assets/wiz/source/wiz_master.png .hermes/assets/wiz/output/review/rigsmith-setup-export.png .hermes/assets/wiz/prepared/manifest.json .hermes/assets/wiz/output/review/rigsmith-setup-diff-x4.png",
    "wiz:capture": "node scripts/wiz/capture-preview.ts && python3 -I scripts/wiz/make_media.py .hermes/assets/wiz/output"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
