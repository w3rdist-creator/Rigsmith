{
  "name": "rigsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Rigsmith — an independent browser-based 2D skeletal animation editor (initial vertical slice).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47613 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47613 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:wiz": "node --test --test-concurrency=1 \"tests/acceptance/**/*.test.ts\"",
    "test:cli": "node --test --test-concurrency=1 \"tests/cli/**/*.test.ts\"",
    "wiz:prepare": "python3 -I scripts/wiz/prepare_cutouts.py .hermes/assets/wiz/source/wiz_master.png .hermes/assets/wiz/prepared",
    "wiz:build": "node scripts/wiz/build-in-editor.ts && python3 -I scripts/wiz/compare_setup.py .hermes/assets/wiz/source/wiz_master.png .hermes/assets/wiz/output/review/rigsmith-setup-export.png .hermes/assets/wiz/prepared/manifest.json .hermes/assets/wiz/output/review/rigsmith-setup-diff-x4.png",
    "wiz:v2": "node scripts/roadmap/wiz-greeting-v2.ts && python3 -I scripts/roadmap/contact_sheet.py .hermes/assets/wiz/roadmap-output/greeting-contact-sheet.png \"greeting (original, unchanged)=.hermes/assets/wiz/roadmap-output/greeting-v1-seq.zip\" \"greeting-v2 (curves, anticipation, overshoot, follow-through)=.hermes/assets/wiz/roadmap-output/greeting-v2-seq.zip\"",
    "wiz:v3": "node scripts/roadmap/wiz-v3.ts",
    "wiz:v3:deliver": "node scripts/roadmap/wiz-v3-deliver.ts",
    "wiz:motion-reuse": "node scripts/roadmap/wiz-motion-reuse.ts",
    "gates": "sh scripts/roadmap/run-gates.sh",
    "demo:phase2": "node scripts/roadmap/demo-phase2.ts",
    "demo:phase3": "node scripts/roadmap/demo-phase3.ts",
    "example:brand": "node examples/brand-pipeline/pipeline.ts",
    "rigsmith": "node scripts/rigsmith.ts",
    "wiz:capture": "node scripts/wiz/capture-preview.ts && python3 -I scripts/wiz/make_media.py .hermes/assets/wiz/output"
  },
  "devDependencies": {
    "lottie-web": "5.13.0",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
